# =============================================================================
# .env.example — plantilla de variables para Docker Compose (entorno local)
#
# Uso:
#   cp .env.example .env
#
# Reglas:
#   - `.env` NO se versiona (está en .gitignore): es tu copia local.
#   - `.env.example` SÍ se versiona: es el molde, sin secretos reales.
#   - Los valores de abajo son solo para el lab. En producción (K8s) los
#     mismos nombres se resuelven desde un Secret.
#   - Si agregás un `${VAR}` en docker-compose.yml, agregala también acá.
# =============================================================================


# -----------------------------------------------------------------------------
# Credenciales entre microservicios
# Viajan como headers en cada llamada interna y el receptor valida ambos:
#   X-Middleware-ApiKey    -> EXTERNAL_API_KEY
#   X-Middleware-DeviceId  -> EXTERNAL_DEVICE_ID
# Tiene que ser el mismo valor en los 4 servicios, o las llamadas dan 403.
# -----------------------------------------------------------------------------
EXTERNAL_API_KEY=idAppXTW37key
EXTERNAL_DEVICE_ID=idDeviceZJA7Device


# -----------------------------------------------------------------------------
# JWT
# Con esta clave user-service firma los tokens y el resto los valida.
# Debe ser idéntica en todos los servicios, o los tokens dan 401.
# En prod: valor aleatorio largo y distinto de este.
# -----------------------------------------------------------------------------
JWT_SECRET=superSecretKeyForJwt!!!


# -----------------------------------------------------------------------------
# PostgreSQL
# Se usan para crear el contenedor `postgres` y para inyectar en los
# microservicios. Las bases se crean en infra/docker/postgres/init.
# -----------------------------------------------------------------------------
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin
