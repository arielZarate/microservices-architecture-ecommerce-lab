# =============================================================================
# .env.example — plantilla de order-service (desarrollo local)
#
# Uso:
#   cp .env.example .env
#
# - `.env` NO se versiona. Este archivo SÍ.
# - Los valores son solo para el lab local.
# - `src/config/env.ts` valida que TODAS existan al arrancar: si falta una,
#   el servicio no levanta (en vez de fallar raro en runtime).
# - En Docker Compose y en K8s, los valores llegan inyectados con estos
#   mismos nombres; no se lee ni `.env` ni ningún yaml.
# =============================================================================


# --- Servidor ----------------------------------------------------------------
PORT=3000


# --- PostgreSQL --------------------------------------------------------------
# Se usan para armar la conexión de Prisma (PrismaPg) en src/lib/prisma.ts.
DATASOURCE_HOST=localhost
DATASOURCE_PORT=5432
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=admin
DATASOURCE_NAME_DATABASE=orders_management


# --- JWT ---------------------------------------------------------------------
# Debe ser la misma clave que usa user-service para firmar, o los tokens
# llegan inválidos (401).
JWT_SECRET=sapee2026superSecretKeyForJwt256bits!!


# --- Kafka -------------------------------------------------------------------
# Desde el host es localhost:9092. Dentro de la red de Compose es el nombre
# del contenedor y el listener interno.
KAFKA_BROKER=localhost:9092
KAFKA_GROUP_ID=order-service-group


# --- Otros servicios ---------------------------------------------------------
# Base URL de products-service para validar productos al crear una orden.
PRODUCT_SERVICE_HOST=http://localhost:8080/api

# Timeout de esas llamadas, en milisegundos.
TIMEOUT_MS=5000


# --- Credenciales entre microservicios ---------------------------------------
# Headers que se envían y validan en cada llamada interna:
#   X-Middleware-ApiKey    -> EXTERNAL_API_KEY
#   X-Middleware-DeviceId  -> EXTERNAL_DEVICE_ID
# Deben coincidir con los de products / shipment / user, o da 403.
EXTERNAL_API_KEY=idAppXTW37key
EXTERNAL_DEVICE_ID=idDeviceZJA7Device


# --- CLI de Prisma (no la usa el runtime) -------------------------------------
# `prisma.config.ts` lee DATABASE_URL: la necesitan `prisma migrate`,
# `prisma generate` y `prisma studio` cuando los corrés desde tu máquina.
# El runtime NO la usa: la conexión del servidor se arma con las
# DATASOURCE_* de arriba (src/lib/prisma.ts).
# En Compose la inyecta el job `order-service-migrate`.
# Tiene que apuntar a la MISMA base que DATASOURCE_*.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/orders_management
